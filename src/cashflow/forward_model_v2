import casadi as ca
import numpy as np
import pandas as pd

def get_cash_index(df_data: pd.DataFrame, cash_ticker: str = "CASH") -> int:
    """
    Identifie dynamiquement l'indice de l'actif numéraire dans l'univers.
    """
    if "Ticker" not in df_data.columns:
        raise ValueError("df_data doit contenir une colonne 'Ticker'.")
        
    tickers = df_data["Ticker"].astype(str).str.upper().tolist()
    cash_ticker_up = cash_ticker.upper()
    
    if cash_ticker_up not in tickers:
        raise ValueError(f"Ticker '{cash_ticker}' introuvable dans df_data. Requis pour le Cashflow.")
        
    return tickers.index(cash_ticker_up)

def build_cashflow_expressions(t_buy, t_sell, w0, nav0, cashflow_amount, cash_idx, tc_rate=0.0):
    """
    Génère les expressions CasADi reliant les trades (t_buy, t_sell) aux poids finaux w1.
    Intègre les frais de transaction (tc_rate) directement dans la poche de liquidité.
    """
    nav1 = float(nav0) + float(cashflow_amount)
    n_assets = len(w0)
    
    non_cash_idx = [i for i in range(n_assets) if i != cash_idx]
    
    w1_expr = ca.MX.zeros(n_assets, 1)
    v1_expr = ca.MX.zeros(n_assets, 1)
    
    # Le vecteur de trade net directionnel
    t_net = t_buy - t_sell
    
    # Le vecteur des coûts (Frais proportionnels au volume brut)
    tc_costs = float(tc_rate) * (t_buy + t_sell)
    
    # 1. Évolution de la poche risquée
    for k, idx in enumerate(non_cash_idx):
        v1_expr[idx] = w0[idx] * float(nav0) + t_net[k]
        w1_expr[idx] = v1_expr[idx] / nav1
        
    # 2. Évolution de la poche numéraire (Budget autofinancé sous friction)
    sum_t_net = ca.sum1(t_net)
    sum_tc = ca.sum1(tc_costs)
    
    # Le cash encaisse le flux, paie les trades nets, ET paie la friction brute
    v1_expr[cash_idx] = w0[cash_idx] * float(nav0) + float(cashflow_amount) - sum_t_net - sum_tc
    w1_expr[cash_idx] = v1_expr[cash_idx] / nav1
    
    return {
        "w1": w1_expr,
        "v1": v1_expr,
        "cash1": v1_expr[cash_idx],
        "t_net": t_net,
        "t_buy": t_buy,
        "t_sell": t_sell,
        "tc_costs": sum_tc,
        "non_cash_idx": non_cash_idx
    }

def cashflow_numpy(t_buy, t_sell, w0, nav0, cashflow_amount, cash_idx, tc_rate=0.0):
    """
    Rétro-calcul déterministe pour le reporting final (Numpy).
    """
    nav1 = float(nav0) + float(cashflow_amount)
    n_assets = len(w0)
    
    t_buy = np.asarray(t_buy, dtype=float).flatten()
    t_sell = np.asarray(t_sell, dtype=float).flatten()
    
    non_cash_idx = [i for i in range(n_assets) if i != cash_idx]
    
    w1 = np.zeros(n_assets, dtype=float)
    v1 = np.zeros(n_assets, dtype=float)
    
    t_net = t_buy - t_sell
    tc_costs = float(tc_rate) * (t_buy + t_sell)
    
    for k, idx in enumerate(non_cash_idx):
        v1[idx] = w0[idx] * float(nav0) + t_net[k]
        w1[idx] = v1[idx] / nav1
        
    sum_t_net = np.sum(t_net)
    sum_tc = np.sum(tc_costs)
    
    v1[cash_idx] = w0[cash_idx] * float(nav0) + float(cashflow_amount) - sum_t_net - sum_tc
    w1[cash_idx] = v1[cash_idx] / nav1
    
    return {
        "w1": w1,
        "v1": v1,
        "nav1": nav1,
        "cash1": float(v1[cash_idx]),
        "t_net": t_net,
        "t_buy": t_buy,
        "t_sell": t_sell,
        "tc_costs_total": float(sum_tc),
        "non_cash_idx": non_cash_idx
    }
